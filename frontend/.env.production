# Backend URL used when building the frontend for production (npm run build).
# This MUST point at your deployed backend, otherwise the app fetches a relative
# "/ask" path on the static host and every request fails with "Failed to fetch".
#
# Default below matches the Render service name in render.yaml (herbigpt-backend).
# If your Render/Cloud Run URL differs, update this value before building.
REACT_APP_API_URL=https://herbigpt-backend.onrender.com
